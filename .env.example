# 应用配置
APP_NAME=电商售后知识库智能问答助手
DEBUG=false
API_PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./rag_assistant.db

# LLM 配置（请替换为你的真实密钥）
DASHSCOPE_API_KEY=sk-请替换为你的真实密钥
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-turbo

# 检索配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
MIN_SCORE=0.3

# JWT 配置（请替换为你的真实密钥）
SECRET_KEY=请替换为你的真实密钥
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080